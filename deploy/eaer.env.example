# 精简版部署配置（docs/部署说明.md）。复制为 deploy/eaer.env 后填写；deploy/eaer.env 不纳入版本控制。
# 编排文件同时用它做变量替换：docker compose --env-file deploy/eaer.env up -d

# 数据库口令（PostgreSQL 只在编排网络内可访问，不对外开放端口）
EAER_DB_PASSWORD=
# 接口对外端口
EAER_API_PORT=8000
# OpenSearch 堆内存（文档量大时调大，见机器规格对照表）
EAER_OPENSEARCH_HEAP=1g

# 模型服务（开发文档 12.2、13.2：部署时必填，缺任何一项接口与后台进程都启动报错）
# 生成：OpenAI 兼容的 /chat/completions
EAER_GEN_BASE_URL=
EAER_GEN_API_KEY=
EAER_GEN_MODEL=
EAER_GEN_THINKING=disabled
EAER_GEN_TEMPERATURE=0
# Embedding 与重排：可以是线上服务，也可以是本地模型服务（modelserver/，容器内访问宿主机用 host.docker.internal）
EAER_EMBED_BASE_URL=
EAER_EMBED_API_KEY=
EAER_EMBED_MODEL=
EAER_EMBED_DIMS=
EAER_EMBED_QUERY_INSTRUCTION=
EAER_RERANK_BASE_URL=
EAER_RERANK_API_KEY=
EAER_RERANK_MODEL=

# 中文分词（默认 standard；改了要重建索引）
EAER_TEXT_ANALYZER=standard
# 准入（开发文档 12.3）：required 时 Verified 与 Deep 只对通过准入检查的模型开启；部署后先跑准入检查（见部署说明）
EAER_ADMISSION=required
# Trace 导出：none / console / otlp（otlp 需用 WITH_OTLP=1 构建镜像，并设置 OTEL_EXPORTER_OTLP_ENDPOINT）
EAER_TRACE_EXPORTER=none
